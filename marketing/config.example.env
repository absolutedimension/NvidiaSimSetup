# TrigunAI marketing publisher config. Copy to marketing/.env and fill in.
# .env is gitignored — never commit real keys.

# --- Email: Azure Communication Services ---
# Option A (simplest): paste the ACS connection string from the Azure portal
#   (Communication Service -> Keys -> Connection string)
ACS_CONNECTION_STRING=

# Option B (instead of A): use `az login` on your machine, then set the endpoint
#   ACS_ENDPOINT=https://<your-acs-resource>.communication.azure.com
#   (requires `pip install azure-identity` and the "Contributor"/"Communication
#    and Email Service Owner" role on the resource for your logged-in identity)
ACS_ENDPOINT=

# The verified sender address on your ACS Email domain (same one your magic-link uses)
ACS_SENDER=DoNotReply@trigunai.com

# --- Telegram (optional) ---
# Create a bot via @BotFather -> get the token. Add the bot to your channel as admin.
# TELEGRAM_CHAT_ID can be the public @channelhandle or the numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (optional) ---
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
