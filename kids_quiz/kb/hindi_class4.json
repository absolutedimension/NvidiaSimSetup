  "facts": [
    {
      "statement": "हिंदी वर्णमाला में ग्यारह स्वर होते हैं।",
      "chapter": "कविता का कमाल"
    },
    {
      "statement": "हिंदी वर्णमाला में तैंतीस व्यंजन होते हैं।",
      "chapter": "कविता का कमाल"
    },
    {
      "statement": "जिस शब्द से किसी व्यक्ति, वस्तु, स्थान या भाव का बोध हो, उसे संज्ञा कहते हैं।",
      "chapter": "जयपुर से पत्र"
    },
    {
      "statement": "जिस शब्द से किसी काम के होने का बोध हो, उसे क्रिया कहते हैं।",
      "chapter": "जयपुर से पत्र"
    },
    {
      "statement": "संज्ञा के स्थान पर प्रयोग होने वाले शब्द सर्वनाम कहलाते हैं।",
      "chapter": "नकली हीरे"
    },
    {
      "statement": "संज्ञा या सर्वनाम की विशेषता बताने वाले शब्द विशेषण कहलाते हैं।",
      "chapter": "नकली हीरे"
    },
    {
      "statement": "वाक्य के अंत में पूर्ण विराम (।) लगाया जाता है।",
      "chapter": "कैमरा"
    },
    {
      "statement": "प्रश्नवाचक वाक्य के अंत में प्रश्नवाचक चिह्न (?) लगाया जाता है।",
      "chapter": "कैमरा"
    },
    {
      "statement": "जिन शब्दों का अर्थ एक-दूसरे के विपरीत होता है, उन्हें विलोम शब्द कहते हैं।",
      "chapter": "आसमान गिरा"
    },
    {
      "statement": "समान अर्थ बताने वाले शब्दों को पर्यायवाची शब्द कहते हैं।",
      "chapter": "नीम"
    },
    {
      "statement": "एक वस्तु का बोध कराने वाला शब्द एकवचन और एक से अधिक का बोध कराने वाला बहुवचन कहलाता है।",
      "chapter": "मिठाइयों का सम्मेलन"
    },
    {
      "statement": "शब्दों के दो लिंग होते हैं — पुल्लिंग और स्त्रीलिंग।",
      "chapter": "हमारा आदित्य"
    }
  ]
