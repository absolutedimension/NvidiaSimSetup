  "facts": [
    {
      "statement": "The English alphabet has 26 letters.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "The five vowels are a, e, i, o and u.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "All the letters that are not vowels are called consonants.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "A naming word is the name of a person, animal, place or thing.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "A doing word tells us what someone or something does.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "We use 'a' before words that begin with a consonant sound, like 'a ball'.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "We use 'an' before words that begin with a vowel sound, like 'an apple'.",
      "chapter": "Unit 3: Food"
    },
    {
      "statement": "Every sentence begins with a capital letter.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "A telling sentence ends with a full stop.",
      "chapter": "Unit 2: Life Around Us"
    },
    {
      "statement": "The word 'I' is always written as a capital letter.",
      "chapter": "Unit 1: My Family and Me"
    },
    {
      "statement": "The name of a person begins with a capital letter.",
      "chapter": "Unit 1: My Family and Me"
    },
    {
      "statement": "In summer the weather is very hot.",
