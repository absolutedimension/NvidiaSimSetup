  "facts": [
    {
      "statement": "Many animals have sharper senses than humans; an ant follows the smell trail left by other ants to find its way.",
      "chapter": "Super Senses"
    },
    {
      "statement": "Snakes are reptiles, and most kinds of snakes are not poisonous; in India snakes are protected by law.",
      "chapter": "A Snake Charmer's Story"
    },
    {
      "statement": "The tongue helps us sense different tastes, such as sweet, sour, salty and bitter.",
      "chapter": "From Tasting to Digesting"
    },
    {
      "statement": "Digestion of food begins in the mouth, where saliva mixes with the food and starts breaking it down.",
      "chapter": "From Tasting to Digesting"
    },
    {
      "statement": "Foods like mango can be preserved as pickle or jam so that we can eat them even when they are out of season.",
      "chapter": "Mangoes Round the Year"
    },
    {
      "statement": "Seeds are carried, or dispersed, from place to place by wind, water and animals.",
      "chapter": "Seeds and Seeds"
    },
    {
      "statement": "A stepwell, also called a baoli, is an old structure built to store water and reached by a flight of steps.",
      "chapter": "Every Drop Counts"
    },
    {
      "statement": "When water is heated it evaporates into vapour, and when the vapour cools it condenses back into water.",
      "chapter": "Experiments with Water"
    },
    {
      "statement": "Mosquitoes lay their eggs in still water, so we should not let water collect and stagnate near our homes.",
      "chapter": "A Treat for Mosquitoes"
    },
    {
      "statement": "Petrol and diesel are made from petroleum, a natural resource that will finish one day, so we must use it carefully.",
      "chapter": "What if it Finishes …?"
    },
    {
      "statement": "In space there is almost no gravity, so astronauts and objects float and feel weightless.",
      "chapter": "Sunita in Space"
    },
    {
      "statement": "An earthquake is the sudden shaking of the ground caused by movements deep inside the Earth.",
      "chapter": "When the Earth Shook!"
    }
  ]
