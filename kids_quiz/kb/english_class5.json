  "facts": [
    {
      "statement": "English has five vowels: a, e, i, o and u.",
      "chapter": "Unit 1: Let's Have Fun"
    },
    {
      "statement": "The alphabet has 26 letters, so the other 21 letters are called consonants.",
      "chapter": "Unit 1: Let's Have Fun"
    },
    {
      "statement": "A naming word for a person, place, animal or thing is called a noun.",
      "chapter": "Unit 5: Work is Worship"
    },
    {
      "statement": "A word that shows an action, such as run or jump, is called a verb.",
      "chapter": "Unit 5: Work is Worship"
    },
    {
      "statement": "We use 'an' before words that begin with a vowel sound and 'a' before words that begin with a consonant sound.",
      "chapter": "Unit 1: Let's Have Fun"
    },
    {
      "statement": "A word that describes a noun, such as tall, blue or gentle, is called an adjective.",
      "chapter": "Unit 2: My Colourful World"
    },
    {
      "statement": "The special names of people, places and days begin with a capital letter and are called proper nouns.",
      "chapter": "Unit 5: Work is Worship"
    },
    {
      "statement": "A sentence begins with a capital letter and usually ends with a full stop.",
      "chapter": "Unit 1: Let's Have Fun"
    },
    {
      "statement": "A sentence that asks something ends with a question mark (?).",
      "chapter": "Unit 4: Ups and Downs"
    },
    {
      "statement": "Words that have opposite meanings, such as up and down, are called antonyms.",
      "chapter": "Unit 4: Ups and Downs"
    },
    {
      "statement": "Words that have the same or nearly the same meaning are called synonyms.",
      "chapter": "Unit 1: Let's Have Fun"
    },
    {
      "statement": "A word that takes the place of a noun, such as he, she, it or they, is called a pronoun.",
      "chapter": "Unit 3: Water"
    }
  ]
