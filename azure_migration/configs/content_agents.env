# Content Agents — Trigun AI Setup
# Routes VLM calls through local LiteLLM proxy → Azure OpenAI gpt-4o-mini

# --- LiteLLM proxy (acts as OpenAI-compatible endpoint) ---
OPENAI_API_KEY=sk-trigunai-master-key-2026
OPENAI_BASE_URL=http://172.31.32.216:4000/v1
OPENAI_API_BASE=http://172.31.32.216:4000/v1

# --- Material Agent: use OpenAI (= LiteLLM proxy = Azure gpt-4o-mini) ---
MA_VLM_BACKEND=openai
MA_VLM_MODEL=gpt-4o-mini
MA_LLM_BACKEND=openai
MA_LLM_MODEL=gpt-4o-mini

# --- Physics Agent: same ---
PA_VLM_BACKEND=openai
PA_VLM_MODEL=gpt-4o-mini
PA_LLM_BACKEND=openai
PA_LLM_MODEL=gpt-4o-mini

# --- Texture Agent ---
# Auto-prompt LLM (writes texture descriptions)
TA_LLM_BACKEND=openai
TA_LLM_MODEL=gpt-4o-mini
TA_LLM_BASE_URL=http://172.31.32.216:4000/v1
# Image generation (renders the actual texture maps)
TA_IMAGE_GEN_BACKEND=openai
TA_IMAGE_GEN_MODEL=gpt-image-1.5
TA_IMAGE_GEN_BASE_URL=http://172.31.32.216:4000/v1
TA_IMAGE_GEN_API_KEY=sk-trigunai-master-key-2026

# --- Rendering: encode multi-view renders inline (no S3 needed) ---
MA_RENDERING_USE_DATA_URI=true

# --- OpenTelemetry ---
OTEL_ENABLED=false
