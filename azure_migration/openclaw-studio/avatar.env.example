# ~/.openclaw/avatar.env  (chmod 600 on Box A) — config for avatar_bridge.sh
# The T4 avatar box (Box B) = SadTalker lip-sync service. Same box as ACE-Step music.

AV_HOST=20.17.162.96                 # T4 public IP (changes on dealloc — re-check if SSH fails)
AV_USER=azureuser
AV_KEY=$HOME/.ssh/t4_avatar.pem      # provision this key on Box A (SETUP step 1)
AV_API=http://127.0.0.1:8080         # SadTalker API, local-only on B (we drive it over SSH)
AV_FACE=$HOME/acharya_presenter.png  # brand persona on B (auto-generated first run if absent)

# Persona prompt used to generate the face once (make_avatar_image.py on B)
AV_FACE_PROMPT="Warm friendly Indian woman teacher, around 30 years old, gentle confident smile, wearing an elegant simple kurta, soft neutral studio background, professional front-facing portrait, natural lighting"

# T4 lifecycle: how Box A starts/stops B. Options:
#   az   → Box A has an az login scoped to the T4's resource group (preferred, auto start/stop)
#   none → T4 is kept running manually during content hours; bridge won't try to start it
AV_LIFECYCLE=none
AV_AZ_GROUP=ubuntu-new-gp_group
AV_AZ_VM=ubuntu-new-gpu

# Stop B after the avatar step? (only honored when AV_LIFECYCLE=az)
AV_STOP_AFTER=true
