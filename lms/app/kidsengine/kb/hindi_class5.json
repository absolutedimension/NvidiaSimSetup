  "facts": [
    {
      "statement": "हिंदी वर्णमाला में कुल ग्यारह स्वर होते हैं।",
      "chapter": "किरन"
    },
    {
      "statement": "हिंदी वर्णमाला में कुल तैंतीस व्यंजन होते हैं।",
      "chapter": "चाँद का कुरता"
    },
    {
      "statement": "जिस शब्द से किसी व्यक्ति, वस्तु, स्थान या भाव के नाम का पता चले, उसे संज्ञा कहते हैं।",
      "chapter": "न्याय की कुर्सी"
    },
    {
      "statement": "जिस शब्द से किसी काम के होने या करने का पता चले, उसे क्रिया कहते हैं।",
      "chapter": "हमारे ये कलामंदिर"
    },
    {
      "statement": "संज्ञा या सर्वनाम की विशेषता बताने वाले शब्द को विशेषण कहते हैं।",
      "chapter": "चतुर चित्रकार"
    },
    {
      "statement": "संज्ञा के स्थान पर प्रयोग होने वाले शब्द को सर्वनाम कहते हैं।",
      "chapter": "मेरा बचपन"
    },
    {
      "statement": "जिन शब्दों के अर्थ एक जैसे होते हैं, उन्हें पर्यायवाची शब्द कहते हैं।",
      "chapter": "गंगा की कहानी"
    },
    {
      "statement": "जिन शब्दों के अर्थ एक-दूसरे के विपरीत होते हैं, उन्हें विलोम शब्द कहते हैं।",
      "chapter": "न्याय"
    },
    {
      "statement": "शब्द के जिस रूप से एक वस्तु का बोध हो, उसे एकवचन कहते हैं।",
      "chapter": "साङकेन"
    },
    {
      "statement": "शब्द के जिस रूप से एक से अधिक वस्तुओं का बोध हो, उसे बहुवचन कहते हैं।",
      "chapter": "तीन मछलियाँ"
    },
    {
      "statement": "जिस शब्द से पुरुष जाति का बोध हो, उसे पुल्लिंग कहते हैं।",
      "chapter": "सुंदरिया"
    },
    {
      "statement": "जिस शब्द से स्त्री जाति का बोध हो, उसे स्त्रीलिंग कहते हैं।",
      "chapter": "सुंदरिया"
    }
  ]
