  "facts": [
    {
      "statement": "स्वर वे वर्ण हैं जिन्हें बोलने के लिए किसी और वर्ण की सहायता नहीं लेनी पड़ती।",
      "chapter": "इकाई 1: परिवार"
    },
    {
      "statement": "व्यंजन को बोलने के लिए स्वर की सहायता लेनी पड़ती है।",
      "chapter": "इकाई 1: परिवार"
    },
    {
      "statement": "क, ख, ग, घ व्यंजन हैं।",
      "chapter": "इकाई 1: परिवार"
    },
    {
      "statement": "जिस शब्द से किसी व्यक्ति, वस्तु, स्थान या जानवर का नाम पता चले, उसे संज्ञा कहते हैं।",
      "chapter": "इकाई 3: हरी-भरी धरती"
    },
    {
      "statement": "जिस शब्द से किसी काम का पता चले, उसे क्रिया कहते हैं।",
      "chapter": "इकाई 4: मित्रता"
    },
    {
      "statement": "एक वस्तु के लिए एकवचन और एक से अधिक वस्तुओं के लिए बहुवचन का प्रयोग होता है।",
      "chapter": "इकाई 1: परिवार"
    },
    {
      "statement": "जिस शब्द से पुरुष जाति का पता चले, उसे पुल्लिंग कहते हैं।",
      "chapter": "इकाई 1: परिवार"
    },
    {
      "statement": "जिस शब्द से स्त्री जाति का पता चले, उसे स्त्रीलिंग कहते हैं।",
      "chapter": "इकाई 1: परिवार"
    },
    {
      "statement": "विलोम शब्दों का अर्थ एक-दूसरे से उल्टा होता है।",
      "chapter": "इकाई 4: मित्रता"
    },
    {
      "statement": "पर्यायवाची शब्दों का अर्थ एक जैसा होता है।",
      "chapter": "इकाई 5: आकाश"
    },
    {
      "statement": "हर वाक्य के अंत में पूर्ण विराम (।) लगाया जाता है।",
      "chapter": "इकाई 4: मित्रता"
    },
    {
      "statement": "वाक्य शब्दों से मिलकर बनता है।",
      "chapter": "इकाई 4: मित्रता"
    }
  ]
}