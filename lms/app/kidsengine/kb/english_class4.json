 "facts": [
  {
   "statement": "There are five vowels in English: a, e, i, o and u.",
   "chapter": "Unit 1: My Land"
  },
  {
   "statement": "Every letter that is not a vowel is called a consonant.",
   "chapter": "Unit 1: My Land"
  },
  {
   "statement": "A naming word for a person, place, animal or thing is called a noun.",
   "chapter": "Unit 1: My Land"
  },
  {
   "statement": "A word that shows an action, like run or jump, is called a verb.",
   "chapter": "Unit 3: Fun with Games"
  },
  {
   "statement": "A word that describes a noun, like tall or bright, is called an adjective.",
   "chapter": "Unit 4: Up High"
  },
  {
   "statement": "We use 'an' before a word that begins with a vowel sound, as in 'an apple'.",
   "chapter": "Unit 2: My Beautiful World"
  },
  {
   "statement": "We use 'a' before a word that begins with a consonant sound, as in 'a ball'.",
   "chapter": "Unit 2: My Beautiful World"
  },
  {
   "statement": "Every sentence begins with a capital letter.",
   "chapter": "Unit 1: My Land"
  },
  {
   "statement": "A telling sentence ends with a full stop.",
   "chapter": "Unit 3: Fun with Games"
  },
  {
   "statement": "A sentence that asks something ends with a question mark.",
   "chapter": "Unit 3: Fun with Games"
  },
  {
   "statement": "The special name of a person or place is a proper noun and always begins with a capital letter.",
   "chapter": "Unit 1: My Land"
  },
  {
   "statement": "Words with the opposite meaning are called antonyms, and words with the same meaning are called synonyms.",
   "chapter": "Unit 2: My Beautiful World"
  },
  {
   "statement": "A describing word is called an adjective.",
   "chapter": "Grammar"
  },
  {
   "statement": "A word that joins two sentences is called a conjunction.",
   "chapter": "Grammar"
  },
  {
   "statement": "The past tense of 'teach' is 'taught'.",
   "chapter": "Grammar"
  },
  {
   "statement": "A proper noun always begins with a capital letter.",
   "chapter": "Grammar"
  }
