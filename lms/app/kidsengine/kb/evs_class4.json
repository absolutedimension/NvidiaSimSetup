  "facts": [
    {
      "statement": "Green plants make their own food using sunlight, water, and air.",
      "chapter": "Basva's Farm"
    },
    {
      "statement": "The roots of a plant take in water and minerals from the soil.",
      "chapter": "Basva's Farm"
    },
    {
      "statement": "Plants give out oxygen, which humans and animals need to breathe.",
      "chapter": "The Valley of Flowers"
    },
    {
      "statement": "Water can be found in three forms: solid ice, liquid water, and water vapour gas.",
      "chapter": "A River's Tale"
    },
    {
      "statement": "When water is heated it slowly changes into vapour; this is called evaporation.",
      "chapter": "A River's Tale"
    },
    {
      "statement": "A river usually begins in the mountains and flows down into the sea.",
      "chapter": "A River's Tale"
    },
    {
      "statement": "The Sun is the main source of heat and light for the Earth.",
      "chapter": "From the Window"
    },
    {
      "statement": "Bees carry pollen from one flower to another, which helps plants make seeds.",
      "chapter": "Anita and the Honeybees"
    },
    {
      "statement": "A honeybee colony has one queen bee, many worker bees, and some drones.",
      "chapter": "Anita and the Honeybees"
    },
    {
      "statement": "Human beings have five sense organs: the eyes, ears, nose, tongue, and skin.",
      "chapter": "Ear to Ear"
    },
    {
      "statement": "Animals that eat only plants are called herbivores, and animals that eat only other animals are called carnivores.",
      "chapter": "A Day with Nandu"
    },
    {
      "statement": "Some birds fly to far-off warmer places every year to escape the cold; they are called migratory birds.",
      "chapter": "From the Window"
    }
  ]
